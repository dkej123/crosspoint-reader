{
  "title": "Home Assistant",
  "description": "Sends reading sessions and sleep progress to a Home Assistant webhook.",
  "config": { "file": "config.json" },
  "events": {
    "reader.session": {
      "connect": true,
      "request": {
        "method": "POST",
        "url": "{cfg.ha_url}/api/webhook/{cfg.webhook_id}",
        "headers": { "Content-Type": "application/json" },
        "body": "{\"event\":\"reader.session\",\"id\":\"{event.id|json}\",\"ts\":{event.ts},\"book\":\"{event.book|json}\",\"document\":\"{event.document|json}\",\"start_time\":{event.start_time},\"end_time\":{event.end_time},\"duration_seconds\":{event.duration_seconds},\"start_progress_bp\":{event.start_progress_bp},\"end_progress_bp\":{event.end_progress_bp}}"
      }
    },
    "sleep.enter": {
      "request": {
        "method": "POST",
        "url": "{cfg.ha_url}/api/webhook/{cfg.webhook_id}",
        "headers": { "Content-Type": "application/json" },
        "body": "{\"event\":\"sleep.enter\",\"id\":\"{event.id|json}\",\"ts\":{event.ts},\"book\":\"{event.book|json}\",\"percent\":\"{event.percent|json}\"}"
      }
    }
  }
}
